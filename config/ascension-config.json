      "enabled": false,
      "minZones": 3,
      "maxZones": 5
    },
    "enemyMutations": {
      "enabled": false,
      "chance": 0.3
    },
    "skillRunMutations": { "enabled": false },
    "classVariants": { "enabled": false },
    "buildCommitment": { "enabled": false },
    "runMechanics": { "enabled": false },
    "relicExclusivity": { "enabled": false },
    "negativeSynergies": { "enabled": false }
